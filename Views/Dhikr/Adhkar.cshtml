@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResource> localizer

@model IslamicCompanion.Models.AdhkarViewModel
@{
    ViewData["Title"] = "Daily Adhkar";
}

<!-- Page Header -->
<div class="dashboard-header" style="text-align: center; margin-bottom: 2.5rem;">
    <h1>@localizer["Daily Adhkar"]</h1>
    <p style="opacity: 0.9; margin-top: 0.5rem;">@localizer["Find peace in the remembrance of Allah"]</p>
</div>

<!-- Modern Toggle Buttons -->
<div style="display: flex; gap: 1rem; justify-content: center; margin-bottom: 2rem; flex-wrap: wrap;">

    <!-- Morning Button (Sunrise Gradient) -->
    <button onclick="loadList('morning')" id="btn-morning"
            style="flex: 1; min-width: 200px; max-width: 250px; padding: 1.5rem; border: none; border-radius: 16px;
        background: linear-gradient(135deg, #f59e0b, #fbbf24); color: white; font-size: 1.1rem; font-weight: 700;
        cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
        transition: all 0.3s ease;">
        <span style="font-size: 1.5rem;">☀️</span> @localizer["Morning"]
    </button>

    <!-- Evening Button (Dusk Gradient) -->
    <button onclick="loadList('evening')" id="btn-evening"
            style="flex: 1; min-width: 200px; max-width: 250px; padding: 1.5rem; border: none; border-radius: 16px;
        background: linear-gradient(135deg, #312e81, #4f46e5); color: white; font-size: 1.1rem; font-weight: 700;
        cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
        transition: all 0.3s ease;">
        <span style="font-size: 1.5rem;">🌙</span> @localizer["Evening"]
    </button>

    <!-- Sleep Button (Deep Night Gradient) -->
    <button onclick="loadList('sleep')" id="btn-sleep"
            style="flex: 1; min-width: 200px; max-width: 250px; padding: 1.5rem; border: none; border-radius: 16px;
        background: linear-gradient(135deg, #0f172a, #334155); color: white; font-size: 1.1rem; font-weight: 700;
        cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
        transition: all 0.3s ease;">
        <span style="font-size: 1.5rem;">🌌</span> @localizer["Sleep"]
    </button>

    <!-- Travel Button (Sky Gradient) -->
    <button onclick="loadList('travel')" id="btn-travel"
            style="flex: 1; min-width: 200px; max-width: 250px; padding: 1.5rem; border: none; border-radius: 16px;
        background: linear-gradient(135deg, #0284c7, #38bdf8); color: white; font-size: 1.1rem; font-weight: 700;
        cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
        transition: all 0.3s ease;">
        <span style="font-size: 1.5rem;">✈️</span> @localizer["Travel"]
    </button>
</div>

<!-- 1. The Progress Bar -->
<div style="max-width: 600px; margin: 0 auto 2rem auto; width:90%;">
    <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: var(--text-muted); font-size: 0.9rem; font-weight: 600;">
        <span id="progress-text">0 @localizer["of"] 0</span>
        <span id="current-category">@localizer["Progress"]</span>
    </div>
    <div style="width: 100%; background-color: #e5e7eb; border-radius: 99px; height: 10px; overflow: hidden;">
        <div id="progress-fill" style="height: 100%; background: var(--accent-gold); width: 0%; transition: width 0.4s ease; border-radius: 99px;"></div>
    </div>
</div>

<!-- 2. The Single Dhikr Card Area -->
<div class="islamic-card" style="padding: 2rem; max-width: 600px; margin: 0 auto; min-height: 250px; display: flex; flex-direction: column; justify-content: center; width:90%;">

    <!-- THE BADGE -->
    <div style="align-self: flex-end; margin-bottom: 1.5rem;">
        <span id="repeat-badge" style="background-color: var(--primary-main); color: white; padding: 0.4rem 1.2rem; border-radius: 99px; font-weight: 700; font-size: 1.1rem; font-family: 'Amiri', serif; box-shadow: 0 4px 10px rgba(212, 175, 55, 0.4);">
            <!-- Injected via JS -->
        </span>
    </div>

    <p id="dhikr-arabic" style="font-size: 1.8rem; text-align: center; font-family: 'Amiri', serif; color: var(--primary-dark); line-height: 2; margin-bottom: 1.5rem;">
        <!-- Injected via JS -->
    </p>
    <p id="dhikr-translation" style="color: var(--text-muted); font-size: 1.1rem; text-align: center; border-top: 1px dashed var(--border-color); padding-top: 1.5rem; margin: 0;">
        <!-- Injected via JS -->
    </p>
</div>

<!-- Dhikr Counter Section -->
<div class="dhikr-container" style="padding: 2rem; max-width: 600px; margin: 0 auto; min-height: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center; width: 90%;">

    <!-- Cute Title -->
    <h3 style="color: var(--primary-dark); margin-bottom: 20px; font-weight: bold;">@localizer["Dhikr Counter"]</h3>

    <!-- The Big Circular Button -->
    <button class="dhikr-counter-btn" onclick="incrementDhikr()">
        <span id="dhikrCount">0</span>
    </button>
</div>

<!-- 3. Navigation Buttons -->
<div style="display: flex; justify-content: space-between; max-width: 600px; margin: 2rem auto; gap: 1rem; width:90%;">
    <button id="btn-prev" onclick="prevDhikr()" style="flex: 1; padding: 1rem; border: 2px solid var(--accent-gold); background: transparent; color: var(--accent-gold); border-radius: 12px; font-weight: 700; font-size: 1.1rem; cursor: pointer; transition: all 0.3s ease;">
        ← @localizer["Previous"]
    </button>
    <button id="btn-next" onclick="nextDhikr()" style="flex: 1; padding: 1rem; border: none; background: var(--accent-gold); color: white; border-radius: 12px; font-weight: 700; font-size: 1.1rem; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 10px rgba(212, 175, 55, 0.3);">
        @localizer["Next"] →
    </button>
</div>

<!-- FINISH POPUP -->
<div id="finish-popup" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(5px); display: none; align-items: center; justify-content: center; z-index: 9999; opacity: 0; transition: opacity 0.3s ease;">
    <div id="finish-popup-card" style="background: white; padding: 3rem 4rem; border-radius: 24px; text-align: center; box-shadow: 0 15px 35px rgba(0,0,0,0.2); transform: scale(0.8); transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);">
        <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">✨ 🕌 ✨</div>
        <h2 style="font-family: 'Amiri', serif; font-size: 3.5rem; color: var(--accent-gold); margin: 0; line-height: 1.2;">تَقَبَّلَ اللَّهُ</h2>
    </div>
</div>

<!-- JavaScript for Interactivity -->
<script>
    // Grab all three lists from the backend Model
    const morningList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MorningAdhkar));
    const eveningList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EveningAdhkar));
    const sleepList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SleepAdhkar));
    const travelList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TravelAdhkar));

    let currentList = [];
    let currentIndex = 0;

    // Grab UI elements
    const arabicText = document.getElementById('dhikr-arabic');
    const translationText = document.getElementById('dhikr-translation');
    const repeatBadge = document.getElementById('repeat-badge');
    const progressFill = document.getElementById('progress-fill');
    const progressText = document.getElementById('progress-text');
    const categoryText = document.getElementById('current-category');

    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const btnMorning = document.getElementById('btn-morning');
    const btnEvening = document.getElementById('btn-evening');
    const btnSleep = document.getElementById('btn-sleep');
    const btnTravel = document.getElementById('btn-travel');

    // Switches between categories
    function loadList(type) {
        currentIndex = 0; // Reset progress when switching

        // 1. Reset all buttons to "inactive" style first (Added btnTravel here)
        [btnMorning, btnEvening, btnSleep, btnTravel].forEach(btn => {
            btn.style.opacity = '0.5';
            btn.style.transform = 'scale(0.95)';
            btn.style.boxShadow = 'none';
        });

        // 2. Activate the clicked button
        if (type === 'morning') {
            currentList = morningList;
            if (categoryText) categoryText.innerText = '☀️ @localizer["Progress"]';
            btnMorning.style.opacity = '1';
            btnMorning.style.transform = 'scale(1.05)';
            btnMorning.style.boxShadow = '0 8px 15px rgba(245, 158, 11, 0.4)';
        } else if (type === 'evening') {
            currentList = eveningList;
            if (categoryText) categoryText.innerText = '🌙 @localizer["Progress"]';
            btnEvening.style.opacity = '1';
            btnEvening.style.transform = 'scale(1.05)';
            btnEvening.style.boxShadow = '0 8px 15px rgba(49, 46, 129, 0.4)';
        } else if (type === 'sleep') {
            currentList = sleepList;
            if (categoryText) categoryText.innerText = '🌌 @localizer["Progress"]';
            btnSleep.style.opacity = '1';
            btnSleep.style.transform = 'scale(1.05)';
            btnSleep.style.boxShadow = '0 8px 15px rgba(15, 23, 42, 0.4)';
        } else if (type === 'travel') {
            currentList = travelList;
            if (categoryText) categoryText.innerText = '✈️ @localizer["Progress"]';
            btnTravel.style.opacity = '1';
            btnTravel.style.transform = 'scale(1.05)';
            btnTravel.style.boxShadow = '0 8px 15px rgba(2, 132, 199, 0.4)';
        }

        updateUI();
    }

    function updateUI() {
        if (!currentList || currentList.length === 0) {
            arabicText.innerText = "No Adhkar available.";
            translationText.innerText = "";
            return;
        }

        const currentDhikr = currentList[currentIndex];
        const totalAdhkar = currentList.length;

        arabicText.innerText = currentDhikr.ArabicText;
        translationText.innerText = currentDhikr.Translation;

        let repeatText = "";
        switch (currentDhikr.RepeatCount) {
            case 1: repeatText = "مرة واحدة"; break;
            case 2: repeatText = "مرتين"; break;
            case 3: repeatText = "ثلاث مرات"; break;
            case 4: repeatText = "أربع مرات"; break;
            case 7: repeatText = "سبع مرات"; break;
            case 10: repeatText = "عشر مرات"; break;
            case 33: repeatText = "٣٣ مرة"; break;
            case 34: repeatText = "٣٤ مرة"; break;
            case 100: repeatText = "مائة مرة"; break;
            default: repeatText = currentDhikr.RepeatCount + " مرات";
        }
        repeatBadge.innerText = repeatText;

        // Progress Bar Update
        const progressPercentage = ((currentIndex + 1) / totalAdhkar) * 100;
        progressFill.style.width = progressPercentage + '%';
        const translatedOf = '@Html.Raw(localizer["of"].Value)';
        progressText.innerHTML = `<bdi>${currentIndex + 1}</bdi> ${translatedOf} <bdi>${totalAdhkar}</bdi>`;

        // Previous Button Status
        if (currentIndex === 0) {
            btnPrev.style.opacity = '0.3';
            btnPrev.style.pointerEvents = 'none';
        } else {
            btnPrev.style.opacity = '1';
            btnPrev.style.pointerEvents = 'auto';
        }

        // Next Button Status
        if (currentIndex === totalAdhkar - 1) {
            btnNext.innerText = "@localizer["Finish"] ✓";
            btnNext.style.background = "#10b981"; // Green
        } else {
            btnNext.innerText = "@localizer["Next"] →";
            btnNext.style.background = "var(--accent-gold)"; // Back to gold
        }
    }

    function nextDhikr() {
        if (currentIndex < currentList.length - 1) {
            currentIndex++;
            updateUI();
            // Resets the number on the screen
            document.getElementById("dhikrCount").innerText = "0";

            // Resets the saved memory in the browser
            localStorage.setItem("userDhikrCount", 0);
        } else {
            const popup = document.getElementById('finish-popup');
            const popupCard = document.getElementById('finish-popup-card');

            popup.style.display = 'flex';
            setTimeout(() => {
                popup.style.opacity = '1';
                popupCard.style.transform = 'scale(1)';
            }, 10);

            setTimeout(() => {
                window.location.href = '@Url.Action("Index", "Home")';
            }, 2500);

            fetch('/Account/FinishSession', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    console.log("Stats saved! New streak:", data.newStreak);
                }
            })
            .catch(error => console.error("Error saving stats:", error));
        }
    }

    function prevDhikr() {
        if (currentIndex > 0) {
            currentIndex--;
            updateUI();
            // Resets the number on the screen
            document.getElementById("dhikrCount").innerText = "0";

            // Resets the saved memory in the browser
            localStorage.setItem("userDhikrCount", 0);
        }
    }

    // Auto-select on load based on time
    window.addEventListener('load', function () {
        const currentHour = new Date().getHours();

        // 4 AM to 11:59 AM -> Morning
        if (currentHour >= 4 && currentHour < 12) {
            loadList('morning');
        } 
        // 12 PM to 8:59 PM -> Evening
        else if (currentHour >= 12 && currentHour < 21) {
            loadList('evening');
        } 
        // 9 PM to 3:59 AM -> Sleep
        else {
            loadList('sleep');
        }
    });

    // Dhikr Counter
    // 1. When the page loads, check if they already have a saved count
    document.addEventListener("DOMContentLoaded", function() {
        let savedCount = localStorage.getItem("userDhikrCount");
        if (savedCount) {
            document.getElementById("dhikrCount").innerText = savedCount;
        }
    });

    // 2. When the big button is clicked
    function incrementDhikr() {
        let countElement = document.getElementById("dhikrCount");
        let currentCount = parseInt(countElement.innerText);

        currentCount++; // Add 1

        countElement.innerText = currentCount; // Update the screen
        localStorage.setItem("userDhikrCount", currentCount); // Save to phone/computer memory
    }
</script>