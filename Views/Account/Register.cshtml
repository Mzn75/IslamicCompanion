@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up - Islamic Companion</title>

    <!-- 2. You MUST manually include your CSS and Fonts since the layout is gone -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="dashboard-header" style="padding-bottom: 2rem;">
        <h1>Welcome To the Islamic Companion</h1>
    </div>
<div style="max-width: 400px; margin: 4rem auto; padding: 2rem;" class="islamic-card">
    <h2 style="text-align: center; color: var(--primary-dark); margin-bottom: 1.5rem;">Create Account</h2>

    @if (ViewBag.Error != null)
    {
        <div style="background-color: #fee2e2; color: #b91c1c; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; text-align: center;">
            @ViewBag.Error
        </div>
    }

    <form asp-action="Register" method="post">
        <div style="margin-bottom: 1rem;">
            <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-weight: bold;">Full Name</label>
            <input type="text" name="displayName" required style="width: 100%; padding: 0.8rem; border: 1px solid #e5e7eb; border-radius: 8px;" placeholder="e.g. Ahmed Khaled" />
        </div>

        <div style="margin-bottom: 1rem;">
            <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-weight: bold;">Username</label>
            <input type="text" name="username" required style="width: 100%; padding: 0.8rem; border: 1px solid #e5e7eb; border-radius: 8px;" placeholder="Choose a username" />
        </div>

        <div style="margin-bottom: 1.5rem;">
            <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted); font-weight: bold;">Password</label>
            <input type="password" name="password" required style="width: 100%; padding: 0.8rem; border: 1px solid #e5e7eb; border-radius: 8px;" placeholder="Create a password" />
        </div>

        <button type="submit" style="width: 100%; padding: 1rem; background-color: var(--accent-gold); color: white; border: none; border-radius: 8px; font-size: 1.1rem; font-weight: bold; cursor: pointer;">
            Sign Up
        </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem;">
        <p style="color: var(--text-muted);">
            Already have an account?
            <a href="/Account/Login" style="color: var(--accent-gold); font-weight: bold; text-decoration: none;">Log in here</a>
        </p>
    </div>
</div>
</body>
</html>