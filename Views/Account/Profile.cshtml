@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResource> localizer

@model IslamicCompanion.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div style="max-width: 600px; margin: 0 auto; padding: 2rem;">

    <!-- Displaying the Name -->
    <div class="islamic-card" style="padding: 1.5rem; margin-top: 1rem;">
        <h1 style="margin: 0;">@localizer["Hello"], @Model.FullName</h1>
        <p style="font-size: 1.5rem; color: var(--primary-main)">@localizer["Your Username"]: <spans style="font-size: 1.5rem; color: #1E293B">@Model.Username</spans></p>
    </div>

    <!-- Displaying the Streak -->
    <div class="islamic-card" style="padding: 1.5rem; margin-top: 1rem;">
        <h3 style="margin: 0;">@localizer["Current Streak"]:</h3>
        <p style="font-size: 2rem; color: #f59e0b; font-weight: bold; text-align:center;">
            @Model.CurrentStreak @localizer["days"] 🔥
        </p>
    </div>

    <!-- Displaying Total Sessions -->
    <div class="islamic-card" style="padding: 1.5rem; margin-top: 1rem;">
        <h3 style="margin: 0;">@localizer["Total Adhkar Completed"]:</h3>
        <p style="font-size: 1.5rem; color: var(--primary-main); text-align:center;">@Model.TotalAdhkarSessions</p>
    </div>

    <!-- Displaying Total Tasks Score -->
    <div class="islamic-card" style="padding: 1.5rem; margin-top: 1rem;">
        <h3 style="margin: 0;">@localizer["Total Done Tasks"]: </h3>
        <p style="font-size: 1.5rem; color: var(--primary-main); text-align:center;">@Model.TotalDoneTasks</p>
    </div>

    <!-- Displaying Date Joined -->
    <div class="islamic-card" style="padding: 1.5rem; margin-top: 1rem;">
        <h3 style="margin: 0;">@localizer["Member since"]: </h3>
        <p style="font-size: 1.5rem; color: var(--primary-main); text-align:center;">@Model.JoinedDate.ToString("MMMM dd, yyyy")</p>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // 1. Grab the saved tasks from browser memory
        const savedData = JSON.parse(localStorage.getItem('myDailyTasks'));

        let score = 0;

        // 2. Make sure data exists for today
        const today = new Date().toLocaleDateString('en-CA');
        if (savedData && savedData.date === today && savedData.tasks) {

            // 3. Loop through the tasks and count every 'true' (checked) task
            for (const taskName in savedData.tasks) {
                if (savedData.tasks[taskName] === true) {
                    score++;
                }
            }
        }

        // 4. Update the HTML with the final score
        document.getElementById('user-score').innerText = score;
    });
</script>